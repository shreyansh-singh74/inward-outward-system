# Copy to .env and fill in real values. Never commit .env.
# Required by docker-compose.yml (variables with no default fail startup).

# --- Database (compose uses URL-encoded / raw root password) ---
# URL-encoded MySQL root password, e.g. Ritesh%401234 for "Ritesh@1234"
DB_ROOT_PASSWORD_URL=your-url-encoded-password
MYSQL_ROOT_PASSWORD=your-raw-root-password
MYSQL_DATABASE=turn_in_turn_out

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Email (for OTP / notifications) ---
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@example.com

# --- Cloudflare Tunnel (public ingress; nginx is NOT used) ---
# 1. Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel
#    -> Cloudflared connector -> copy the token shown on the install screen.
# 2. Add a Public Hostname for your domain and set its service to http://web:8000
#    ("web" is the compose service name, resolvable inside the compose network).
# 3. Paste the token below. Keep it secret - .env is git-ignored.
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# --- App ---
# Exact public URL served through the Cloudflare Tunnel (must match the
# tunnel's public hostname; used for email links and CORS).
CLIENT_URL=https://your-domain.example.com
PRODUCTION=true
# Comma-separated origins allowed to call the API (must match CLIENT_URL)
CORS_ORIGINS=https://your-domain.example.com

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# --- Seed script (docker compose exec web python seed.py) ---
# Must be real, reachable emails - OTP login is sent to these addresses.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_CLERK_EMAIL=clerk@example.com
SEED_CLERK_USERNAME=clerk

# --- Local development only (not used by docker-compose) ---
DB_URL=mysql+mysqlconnector://root:password@localhost:3306/turn_in_turn_out
REDIS_URL=redis://localhost:6379/0
