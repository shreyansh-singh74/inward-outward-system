# Copy to .env and fill in real values. Never commit .env.
# Required by docker-compose.yml (variables with no default fail startup).

# --- Database (compose uses URL-encoded / raw root password) ---
# URL-encoded MySQL root password, e.g. Ritesh%401234 for "Ritesh@1234"
DB_ROOT_PASSWORD_URL=your-url-encoded-password
MYSQL_ROOT_PASSWORD=your-raw-root-password
MYSQL_DATABASE=turn_in_turn_out

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Email (for OTP / notifications) ---
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@example.com

# --- App ---
# Public domain that Traefik routes to this app
CLIENT_URL=https://your-domain.example.com
PRODUCTION=true
# Comma-separated origins allowed to call the API (must match CLIENT_URL)
CORS_ORIGINS=https://your-domain.example.com

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# --- Local development only (not used by docker-compose) ---
DB_URL=mysql+mysqlconnector://root:password@localhost:3306/turn_in_turn_out
REDIS_URL=redis://localhost:6379/0
